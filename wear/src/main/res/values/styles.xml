<resources>
    <string name="app_name">Open Clock</string>
    <style name="WearClockTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8D83FF</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
    <style name="WearMainTheme" parent="WearClockTheme">
        <!-- The list/editor share one Activity; handle swipe one page at a time. -->
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
