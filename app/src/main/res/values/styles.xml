<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#365EE9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F0F3F9</item>
        <item name="android:navigationBarColor">#F0F3F9</item>
        <item name="android:statusBarColor">#F0F3F9</item>
        <item name="android:alertDialogTheme">@style/ClockDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/ClockDialogTheme</item>
        <item name="android:popupMenuStyle">@style/ClockPopupMenu</item>
    </style>

    <style name="ClockDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#365EE9</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:windowMinWidthMinor">87%</item>
        <item name="android:windowMinWidthMajor">70%</item>
    </style>

    <style name="ClockPopupMenu" parent="android:style/Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_surface</item>
        <item name="android:popupElevation">8dp</item>
    </style>
    <string name="app_name">Open Clock</string>
</resources>
